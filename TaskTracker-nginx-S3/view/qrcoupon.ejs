<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Coupon</title>
    <style>
       body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 1rem;
}

.container {
    max-width: 90%;
    width: 600px;
    padding: 1.25rem;
    background: none;
    text-align: center;
    margin: auto;
    margin-top: 1.25rem;
    box-sizing: border-box;
}

header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.625rem;
    color: #333;
}

.countdown {
    font-size: 1.25rem;
    font-weight: bold;
    color: red;
    margin-bottom: 0.9375rem;
}

.barcode-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 1.25rem 0;
}

.barcode-img {
    width: 90%;
    max-width: 31.25rem;
    max-height: 50vh;
    object-fit: contain;
    height: auto;
}

.btn-confirm {
    display: block;
    margin: 1.25rem auto 0;
    width: 80%;
    max-width: 18.75rem;
    padding: 0.75rem;
    background-color: #28a745;
    color: white;
    font-size: 1rem;
    border: none;
    border-radius: 0.3125rem;
    cursor: pointer;
    transition: background 0.3s ease-in-out;
    box-sizing: border-box;
}

.btn-confirm:hover {
    background-color: #218838;
}

.disabled {
    background-color: gray !important;
    cursor: not-allowed;
}
    </style>
</head>
<body>
    <%- include('navbar') %>
    <div class="container">
        <header>
            <h1>Use Your Coupon</h1>
        </header>
        
        <!-- นาฬิกานับถอยหลัง -->
        <div class="countdown" id="countdown">3:00 ก่อนหมดอายุ</div>

        <main>
            <section class="qr-section">
                <div class="barcode-container">
                    <img src="/assets/images/barcode.jpg" alt="Barcode" class="barcode-img">
                </div>
                <!-- ปุ่มยืนยัน -->
                <form action="/deletecoupon/<%=couponId%>" method="POST">
                    <button class="btn-confirm" id="confirmBtn" type="submit">Confirm</button>
                </form>
            </section>
        </main>
    </div>

    <script>
        const expireAt = new Date("<%= expireAt.toISOString() %>");
        const confirmBtn = document.getElementById("confirmBtn");
        const countdownEl = document.getElementById("countdown");
    
        function updateCountdown() {
            const now = new Date();
            const timeLeft = Math.floor((expireAt - now) / 1000); // วินาทีที่เหลือ
    
            if (timeLeft <= 0) {
                countdownEl.innerHTML = "หมดอายุแล้ว!";
                confirmBtn.disabled = true;
                confirmBtn.classList.add("disabled");
    
                // ส่งไปลบคูปองจาก server (ถ้ายังไม่ได้ลบ)
                fetch(`/deletecoupon/<%= couponId %>`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ couponId: "<%= couponId %>" })
                }).then(response => response.json())
                  .then(data => {
                      if (!data.error) {
                          window.location.href = '/tasks';
                      } else {
                          window.location.href = '/login';
                      }
                  }).catch(error => console.error('Error:', error));
            } else {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                countdownEl.innerHTML = `${minutes}:${seconds < 10 ? "0" + seconds : seconds} ก่อนหมดอายุ`;
            }
        }
    
        updateCountdown(); // เรียกตอนแรก
        setInterval(updateCountdown, 1000);
    </script>
    
</body>
</html>
