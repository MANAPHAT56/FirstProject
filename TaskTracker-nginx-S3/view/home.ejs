<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Tote+</title>
    <link rel="stylesheet" href="https://cdn.toteja.co/public/css/home.css">
     <link rel="stylesheet" href="/assets/css/playads.css">
   <script src="https://cdn.toteja.co/public/js/index.js" defer></script>
       <script src="/assets/js/playads.js" defer></script>
</head>
<body>
    <%- include('navbar') %>
    <br>  
  <button class="button" id="showAd">WATCH ADs to get more points</button>

<!-- Ad Overlay -->
<div class="ad-overlay" id="adOverlay" style="display: none;">
  <div class="ad-video-container">
    <button class="close-ad" id="closeAd">X</button>
    <video id="adVideo" width="640" controls>
      <!-- <source src="https://cdn.toteja.co/public/videos/ad1.mp4" type="video/mp4"> -->
      Your browser does not support the video tag.
    </video>
  </div>
</div>
    <div class="container">
        <header class="fade-in">
            <img src="https://cdn.toteja.co/public/images/Tote%2B4.png" class="locoja"alt="Eco-friendly Tote Bag">
            <h1>Welcome to Tote+</h1>
            <p>Join us in reducing plastic waste with reusable bags!</p>
        </header>

        <main>
            <section class="intro">
                <div class="image-container">
                    <img src="https://cdn.toteja.co/public/images/Tote%2B3.png" alt="Eco-friendly Tote Bag">
                    <img src="https://cdn.toteja.co/public/images/Tote%2B.png" alt="Eco-friendly Tote Bag">
                </div>
                <div class="content">
                    <p class="fade-in">
                        Tote+ helps you track your reusable bag usage, earn rewards, and find eco-friendly stores.
                    </p>
                    <p class="fade-in">Start your journey by scanning a QR code or exploring our partner stores.</p>
                    <div class="cta-buttons">
                        <a href="/admin" class="button">Login</a>
                        <a href="/create" class="button secondary">Create Account</a>
                    </div>
                </div>
            </section>
        </main>

        <section class="features">
            <h2>Why Use Tote+?</h2>
            <div class="feature-cards">
                <div class="card">
                    <h3>🌱 Reduce Plastic Waste</h3>
                    <p>Track how many plastic bags you've saved.</p>
                </div>
                <div class="card">
                    <h3>🏆 Earn Rewards</h3>
                    <p>Exchange points for exclusive discounts.</p>
                </div>
                <div class="card">
                    <h3>🛒 Find Partner Stores</h3>
                    <p>Discover eco-friendly shops near you.</p>
                </div>
            </div>
        </section>
    </div>
</body>
</html>
