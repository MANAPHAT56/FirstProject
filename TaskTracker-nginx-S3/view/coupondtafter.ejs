+<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tote+ | รายละเอียดคูปอง</title>
    <style>
        body {
    font-family: Arial, sans-serif;
    text-align: center;
    background-color: #f4f4f4;
    margin: 0;
    padding: 60px 10px 20px 10px; /* padding ด้านข้างเล็กลงสำหรับมือถือ */
}

.coupon-container {
    max-width: 600px;
    margin: 20px auto;
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    font-size: 1.2em;
    text-align: left;
}

.coupon-image {
    width: 160px;
    height: auto;
    border-radius: 5px;
    margin: 30px auto;
    display: block;
}

.redeem-button {
    background-color: #ff9800;
    color: white;
    border: none;
    padding: 12px 20px;
    cursor: pointer;
    border-radius: 5px;
    font-size: 1.2em;
    margin: 30px auto 0 auto;
    display: block;
}

.redeem-button:hover {
    background-color: #e68900;
}

.coupon-item {
    margin-bottom: 30px;
    padding: 25px;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
    font-size: 1.2em;
}

h2 {
    text-align: left;
    margin-left: 10px;
    font-size: 1.5em;
}

.coupon-item div {
    margin-bottom: 25px;
}

/* ✅ Responsive สำหรับหน้าจอเล็ก */
@media (max-width: 768px) {
    .coupon-container {
        padding: 20px;
        font-size: 1em;
    }

    .coupon-item {
        padding: 20px;
        font-size: 1em;
    }

    .coupon-image {
        width: 100%;
        max-width: 280px;
    }

    .redeem-button {
        font-size: 1em;
        padding: 10px 15px;
    }

    h2 {
        font-size: 1.3em;
    }
}

    </style>
    <script>
        function redeemCoupon(couponId, couponImg, couponName) {
            fetch('/redeem-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponId: couponId, couponImg: couponImg, couponName: couponName })
            })
            .then(response => response.json())
            .then(data => {
                if (!data.error) {
                    alert('แลกคูปองสำเร็จ!');
                } else {
                    alert('เกิดข้อผิดพลาด: ' + data.error);
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
</head>
<body>
    <%- include("navbar") %> 
    <div class="coupon-container">
        <h2>รายละเอียดคูปอง</h2>
        <% coupondt.forEach(coupon => { %>
            <div class="coupon-item">
                <div><strong>ชื่อคูปอง:</strong> <%= coupon.name %></div>
                <div><img src="<%= coupon.img %>" alt="คูปอง <%= coupon.name %>" class="coupon-image"></div>
                <div><strong>คำอธิบาย:</strong> <%= coupon.description %></div>
                <div><strong class="KUY">Store: </strong><%= storeName %></div>
            </div>
        <% }); %>
    </div>
</body>
</html>
